---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { content } from "../i18n/content.js";

const { lang = "en" } = Astro.props;
const t = content[lang];
---
<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description}>
  <div id="top">
    <Header lang={lang} />

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="hero-bg" aria-hidden="true">
          <span class="blob blob-a"></span>
          <span class="blob blob-b"></span>
        </div>
        <div class="wrap hero-inner">
          <span class="monogram hero-monogram">CR</span>
          <p class="eyebrow">{t.hero.eyebrow}</p>
          <h1 class="hero-title">Carlos Rubio</h1>
          <p class="hero-tagline">{t.hero.tagline}</p>
          <div class="hero-actions">
            <a href="#projects" class="btn btn-primary">{t.hero.viewProjects}</a>
            <a href="#contact" class="btn btn-ghost">{t.hero.getInTouch}</a>
          </div>
          <div class="hero-stats">
            {t.hero.stats.map((s) => (
              <div class="stat">
                <span class="stat-num" data-count={s.count}>0</span>
                <span class="stat-label">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- SKILLS -->
      <section id="skills" class="section">
        <div class="wrap">
          <div class="reveal">
            <p class="section-label">{t.skills.label}</p>
            <h2 class="section-title">{t.skills.title}</h2>
            <p class="section-intro">{t.skills.intro}</p>
          </div>
          <div class="skills-grid">
            {t.skills.groups.map((group, i) => (
              <div class="card skill-card reveal" style={`--delay: ${i * 90}ms`}>
                <h3 class="skill-category">{group.category}</h3>
                <div class="skill-chips">
                  {group.items.map((item) => (
                    <span class="chip chip-muted">{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <p class="bilingual-note">{t.skills.bilingualNote}</p>

          <div class="strengths reveal">
            <h3 class="strengths-title">{t.skills.strengthsTitle}</h3>
            <div class="strength-list">
              {t.skills.strengths.map((s) => (
                <div class="strength-row">
                  <div class="strength-label">
                    <span>{s.name}</span>
                    <span class="strength-pct">{s.level}%</span>
                  </div>
                  <div class="strength-track">
                    <div class="strength-fill" style={`--level: ${s.level}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- EXPERIENCE -->
      <section id="experience" class="section section-alt">
        <div class="wrap">
          <div class="reveal">
            <p class="section-label">{t.experience.label}</p>
            <h2 class="section-title">{t.experience.title}</h2>
          </div>
          {t.experience.jobs.map((job) => (
            <div class="card experience-card reveal">
              <div class="experience-header">
                <div>
                  <h3>{job.role}</h3>
                  <p class="experience-company">{job.company}</p>
                </div>
                <span class="chip experience-period">{job.period}</span>
              </div>
              <ul class="experience-bullets">
                {job.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          ))}
          <p class="experience-note">
            {t.experience.notePre}<a href="#contact">{t.experience.noteLink}</a>{t.experience.notePost}
          </p>
        </div>
      </section>

      <!-- EDUCATION -->
      <section id="education" class="section">
        <div class="wrap">
          <div class="reveal">
            <p class="section-label">{t.education.label}</p>
            <h2 class="section-title">{t.education.title}</h2>
          </div>
          {t.education.items.map((edu) => (
            <div class="card education-card reveal">
              <div class="education-header">
                <div>
                  <h3>{edu.school}</h3>
                  <p class="education-degree">{edu.degree}</p>
                </div>
                <div class="education-meta">
                  <span class="chip education-period">{edu.period}</span>
                  <span class="education-location">{edu.location}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- PROJECTS -->
      <section id="projects" class="section section-alt">
        <div class="wrap">
          <div class="reveal">
            <p class="section-label">{t.projects.label}</p>
            <h2 class="section-title">{t.projects.title}</h2>
            <p class="section-intro">{t.projects.intro}</p>
          </div>

          {t.projects.items.map((project) => (
            <div class="card project-card reveal">
              <div class="project-preview">
                <div class="browser-chrome">
                  <span class="dot dot-red"></span>
                  <span class="dot dot-yellow"></span>
                  <span class="dot dot-green"></span>
                  <span class="browser-url">{project.url.replace("https://", "")}</span>
                </div>
                <div class="browser-body">
                  <div class="mock-nav">
                    <span class="mock-logo"></span>
                    <span class="mock-nav-lines"></span>
                  </div>
                  <p class="mock-eyebrow">{project.mock.eyebrow}</p>
                  <h4 class="mock-headline">
                    {project.mock.headlinePrefix} <em>{project.mock.headlineEm}</em>
                    <br />
                    {project.mock.headlineSuffix}
                  </h4>
                  <p class="mock-sub">{project.mock.sub}</p>
                  <div class="mock-buttons">
                    <span class="mock-btn mock-btn-solid">{project.mock.btnSolid}</span>
                    <span class="mock-btn mock-btn-outline">{project.mock.btnOutline}</span>
                  </div>
                </div>
              </div>

              <div class="project-details">
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <div class="project-stack">
                  {project.stack.map((tech) => (
                    <span class="chip">{tech}</span>
                  ))}
                </div>
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary project-link">
                  {t.projects.visitSite} &nbsp;→
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CONTACT -->
      <section id="contact" class="section contact-section">
        <div class="wrap contact-inner reveal">
          <p class="section-label">{t.contact.label}</p>
          <h2 class="section-title">{t.contact.title}</h2>
          <p class="section-intro contact-intro">{t.contact.intro}</p>
          <a href={`mailto:${t.contact.email}`} class="btn btn-primary contact-btn">{t.contact.email}</a>
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</BaseLayout>

<script>
  const revealEls = document.querySelectorAll(".reveal");
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.15 }
  );
  revealEls.forEach((el) => revealObserver.observe(el));

  const fills = document.querySelectorAll(".strength-fill");
  const strengthObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          strengthObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 }
  );
  fills.forEach((el) => strengthObserver.observe(el));

  const animateCount = (el: HTMLElement) => {
    const target = parseInt(el.dataset.count || "0", 10);
    const duration = 900;
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      el.textContent = Math.round(progress * target).toString();
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  const counters = document.querySelectorAll<HTMLElement>(".stat-num");
  const counterObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          animateCount(entry.target as HTMLElement);
          counterObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.5 }
  );
  counters.forEach((el) => counterObserver.observe(el));

  const sections = document.querySelectorAll("main section[id]");
  const spyObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        const link = document.querySelector(`.nav-links a[href="#${id}"]`);
        if (entry.isIntersecting) {
          document.querySelectorAll(".nav-links a").forEach((a) => a.classList.remove("active"));
          link?.classList.add("active");
        }
      });
    },
    { rootMargin: "-40% 0px -50% 0px", threshold: 0 }
  );
  sections.forEach((s) => spyObserver.observe(s));
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 120px 0 96px;
    text-align: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.35;
  }

  .blob-a {
    width: 320px;
    height: 320px;
    background: var(--accent);
    top: -80px;
    left: 8%;
  }

  .blob-b {
    width: 260px;
    height: 260px;
    background: var(--accent-2);
    bottom: -60px;
    right: 6%;
    animation-delay: -6s;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-stats {
    display: flex;
    gap: 36px;
    margin-top: 12px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-num {
    font-family: "Sora", sans-serif;
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 88px 0 64px;
    }

    .hero-monogram {
      width: 76px;
      height: 76px;
      font-size: 1.6rem;
    }

    .hero-stats {
      gap: 22px;
    }
  }

  .hero-monogram {
    width: 96px;
    height: 96px;
    font-size: 2rem;
    margin-bottom: 28px;
    box-shadow: 0 12px 32px rgba(79, 70, 229, 0.28);
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
    margin: 0 0 8px;
  }

  .hero-title {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 700;
  }

  .hero-tagline {
    max-width: 46ch;
    color: var(--text-muted);
    font-size: 1.08rem;
    margin: 20px 0 32px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
  }

  .section-alt {
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
  }

  .skill-card {
    padding: 24px;
  }

  .skill-category {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 14px;
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .bilingual-note {
    margin-top: 28px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .strengths {
    margin-top: 44px;
  }

  .strengths-title {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .strength-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .strength-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .strength-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .strength-pct {
    color: var(--text-muted);
    font-weight: 500;
  }

  .strength-track {
    height: 8px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }

  .strength-fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .strength-fill.is-visible {
    width: var(--level);
  }

  .experience-card {
    padding: 32px;
  }

  .experience-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .experience-header h3 {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .experience-company {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 4px 0 0;
  }

  .experience-period {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .experience-bullets {
    margin: 0;
    padding-left: 20px;
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .experience-note {
    margin-top: 20px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .experience-note a {
    color: var(--accent);
    font-weight: 600;
  }

  .experience-card + .experience-card {
    margin-top: 16px;
  }

  @media (max-width: 480px) {
    .experience-header {
      flex-direction: column;
    }
  }

  .education-card {
    padding: 32px;
  }

  .education-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .education-header h3 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .education-degree {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 4px 0 0;
  }

  .education-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    flex-shrink: 0;
  }

  .education-location {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  @media (max-width: 480px) {
    .education-header {
      flex-direction: column;
    }

    .education-meta {
      align-items: flex-start;
    }
  }

  .project-card {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 0;
    overflow: hidden;
  }

  @media (max-width: 780px) {
    .project-card {
      grid-template-columns: 1fr;
    }
  }

  .project-preview {
    background: #0b1120;
    display: flex;
    flex-direction: column;
  }

  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 14px;
    background: #131b2e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }

  .browser-url {
    margin-left: 10px;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.06);
    padding: 3px 10px;
    border-radius: 999px;
  }

  .browser-body {
    background: linear-gradient(160deg, #1b2340 0%, #2a1f3d 55%, #4a2a2a 100%);
    padding: 32px 28px 36px;
    flex: 1;
  }

  .mock-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .mock-logo {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: linear-gradient(135deg, #f97316, #fb7185);
  }

  .mock-nav-lines {
    margin-left: auto;
    width: 20px;
    height: 2px;
    background: rgba(255, 255, 255, 0.4);
    box-shadow: 0 6px 0 rgba(255, 255, 255, 0.4), 0 -6px 0 rgba(255, 255, 255, 0.4);
  }

  .mock-eyebrow {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  .mock-headline {
    color: #fff;
    font-size: 1.5rem;
    line-height: 1.25;
    margin: 0 0 12px;
  }

  .mock-headline em {
    font-style: italic;
    color: #fb923c;
  }

  .mock-sub {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.82rem;
    margin: 0 0 20px;
    max-width: 32ch;
  }

  .mock-buttons {
    display: flex;
    gap: 10px;
  }

  .mock-btn {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 999px;
  }

  .mock-btn-solid {
    background: #f97316;
    color: #fff;
  }

  .mock-btn-outline {
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #fff;
  }

  .project-details {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
  }

  .project-details h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .project-details p {
    color: var(--text-muted);
    margin: 0 0 18px;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .project-link {
    align-self: flex-start;
  }

  .contact-section {
    text-align: center;
  }

  .contact-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-intro {
    margin-left: auto;
    margin-right: auto;
  }

  .contact-btn {
    font-size: 1rem;
    padding: 14px 28px;
  }
</style>
